---
import Base from '../layouts/Base.astro';
import FilterablePosts from '../components/FilterablePosts.astro';
import MemberStatsTable from '../components/MemberStatsTable.astro';
import { SITE, TEAM, MEMBER_KEYS } from '../consts';
import { formatHours, getPosts, sumHours } from '../utils';
import { timelog } from '../data/timelog';

const posts = await getPosts();

const memberStats = MEMBER_KEYS.map((key) => {
  const entries = timelog.filter((e) => e.member === key);
  return {
    name: TEAM[key].name,
    color: TEAM[key].color,
    values: [
      posts.filter((p) => p.data.authors.includes(key)).length,
      formatHours(sumHours(entries)),
      new Set(entries.map((e) => e.date)).size,
    ],
  };
});
const totals = [posts.length, formatHours(sumHours(timelog)), new Set(timelog.map((e) => e.date)).size];
---

<Base>
  <section class="hero">
    <h1>{SITE.title}</h1>
    <p class="lead">
      A running log of our team's research, design and development process — including feedback, planning, hours and
      an honest account of how we use AI and other technologies.
    </p>
    <MemberStatsTable columns={['Posts', 'Hours logged', 'Days worked']} rows={memberStats} total={totals} />
  </section>

  <FilterablePosts posts={posts} />
</Base>

<style>
  .hero {
    margin-bottom: 3rem;
  }
</style>
