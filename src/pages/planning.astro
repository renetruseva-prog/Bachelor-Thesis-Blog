---
import Base from '../layouts/Base.astro';
import TopicChip from '../components/TopicChip.astro';
import { phases, planningToolUrl, type Status } from '../data/planning';
import { formatDate } from '../utils';

const statusLabel: Record<Status, string> = { todo: 'To do', doing: 'In progress', done: 'Done' };
const range = (start: string, end: string) =>
  start && end ? `${formatDate(new Date(start))} – ${formatDate(new Date(end))}` : 'Dates TBD';
---

<Base title="Planning" description="Detailed project planning for the bachelor thesis.">
  <p class="eyebrow">Projects</p>
  <h1>Planning</h1>
  <p class="lead">
    The phases of the project, with their timing and tasks. Changes to the planning are explained in posts tagged
    “Planning”.
  </p>
  {
    planningToolUrl && (
      <p>
        <a href={planningToolUrl} target="_blank" rel="noopener">
          Open the detailed planning board ↗
        </a>
      </p>
    )
  }

  <ol class="timeline">
    {
      phases.map((phase, i) => {
        const done = phase.tasks.filter((t) => t.done).length;
        return (
          <li class={`phase ${phase.status}`}>
            <span class="dot" aria-hidden="true" />
            <div class="card">
              <div class="head">
                <span class="index">Phase {i + 1}</span>
                <span class={`status ${phase.status}`}>{statusLabel[phase.status]}</span>
              </div>
              <h2>{phase.title}</h2>
              <p class="dates">{range(phase.start, phase.end)}</p>
              <div class="labels">
                {phase.topics.map((t) => (
                  <TopicChip topic={t} />
                ))}
              </div>
              {phase.tasks.length > 0 && (
                <>
                  <progress max={phase.tasks.length} value={done} aria-label={`${done} of ${phase.tasks.length} tasks done`} />
                  <ul class="tasks">
                    {phase.tasks.map((task) => (
                      <li class={task.done ? 'done' : ''}>{task.label}</li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>
</Base>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--line);
  }
  .phase {
    position: relative;
    padding-left: 2.25rem;
    margin-bottom: 1rem;
  }
  .dot {
    position: absolute;
    left: 0;
    top: 1.5rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line);
  }
  .doing .dot {
    border-color: var(--butter);
    background: var(--butter);
  }
  .done .dot {
    border-color: var(--accent);
    background: var(--accent);
  }
  .head {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .status {
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--line);
    color: var(--ink);
  }
  .status.doing {
    background: #fbf4d6;
  }
  .status.done {
    background: var(--accent-soft);
  }
  h2 {
    margin: 0.35rem 0 0.2rem;
    font-size: 1.3rem;
  }
  .dates {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  progress {
    width: 100%;
    height: 0.4rem;
    margin-top: 1rem;
    appearance: none;
    border: 0;
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;
  }
  progress::-webkit-progress-bar {
    background: var(--line);
  }
  progress::-webkit-progress-value {
    background: var(--accent);
  }
  progress::-moz-progress-bar {
    background: var(--accent);
  }
  .tasks {
    margin: 0.75rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.92rem;
  }
  .tasks .done {
    color: var(--muted);
    text-decoration: line-through;
  }
</style>
