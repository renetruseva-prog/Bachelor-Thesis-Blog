---
import Base from '../layouts/Base.astro';
import TopicChip from '../components/TopicChip.astro';
import { team } from '../data/team';
---

<Base title="Team" description="Team roles: who does what.">
  <p class="eyebrow">Team roles</p>
  <h1>Who does what</h1>
  <p class="lead">The people involved in the project and their roles in the team.</p>

  <div class="grid">
    {
      team.map((m) => (
        <article class="card">
          <h2>{m.name}</h2>
          <p class="role">{m.role}</p>
          <div class="labels">
            {m.topics.map((t) => (
              <TopicChip topic={t} />
            ))}
          </div>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
    margin: 2.5rem 0 0;
  }
  .card h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .role {
    color: var(--muted);
    font-size: 0.92rem;
    margin-bottom: 0.75rem;
  }
  .labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
