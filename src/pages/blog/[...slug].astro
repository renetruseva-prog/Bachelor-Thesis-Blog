---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopicChip from '../../components/TopicChip.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import { formatDate, getPosts, slugify, url } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, topics, tags, placeholder } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={description}>
  <article class="prose">
    <a class="back" href={url('/')}>← All posts</a>
    <header>
      <div class="labels">
        {topics.map((topic) => <TopicChip topic={topic} />)}
      </div>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, { month: 'long' })}</time>
        {updatedDate && <span> · updated {formatDate(updatedDate, { month: 'long' })}</span>}
      </p>
      {placeholder && <p class="note">This is a placeholder post — content coming soon.</p>}
    </header>

    <div class="content">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <p class="tags">
          {tags.map((tag) => (
            <a class="tag" href={url(`/tags/${slugify(tag)}`)}>
              {tag}
            </a>
          ))}
        </p>
      )
    }

    <nav class="pager" aria-label="More posts">
      {
        older ? (
          <a href={url(`/blog/${older.id}`)}>
            <span>← Older</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a class="next" href={url(`/blog/${newer.id}`)}>
            <span>Newer →</span>
            {newer.data.title}
          </a>
        )
      }
    </nav>
  </article>

  <ImageLightbox selector=".content img" />
</Base>

<style>
  .back {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 2rem;
  }
  .labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .meta {
    font-size: 0.9rem;
    color: var(--muted);
  }
  header {
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .content :global(h2) {
    margin-top: 2.5rem;
  }
  .content :global(img) {
    margin: 1rem 0;
  }
  /* Images written on consecutive lines (no blank line between them) sit side by side. */
  .content :global(p:has(> img + img)) {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 0.75rem;
    align-items: start;
  }
  .content :global(p:has(> img + img) img) {
    margin: 0;
    width: 100%;
  }
  @media (max-width: 40rem) {
    .content :global(p:has(> img + img)) {
      grid-auto-flow: row;
    }
  }
  .content :global(figure) {
    margin: 2rem 0;
  }
  .content :global(figcaption) {
    font-size: 0.85rem;
    color: var(--muted);
    text-align: center;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    max-width: 48%;
    text-decoration: none;
    font-family: var(--font-serif);
  }
  .pager span {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
</style>
