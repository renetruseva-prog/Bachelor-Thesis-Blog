---
import Base from '../layouts/Base.astro';
import TopicChip from '../components/TopicChip.astro';
import MemberStatsTable from '../components/MemberStatsTable.astro';
import { TEAM, MEMBER_KEYS, TOPICS, TOPIC_KEYS } from '../consts';
import { timelog, type TimeEntry } from '../data/timelog';
import { formatDate, formatHours as fmt, sumHours } from '../utils';

// Group entries per day, newest first
const byDay = new Map<string, TimeEntry[]>();
for (const entry of [...timelog].sort((a, b) => b.date.localeCompare(a.date))) {
  byDay.set(entry.date, [...(byDay.get(entry.date) ?? []), entry]);
}
const days = [...byDay].map(([date, entries]) => ({
  date: new Date(date),
  // Within a day, list entries per member in team order.
  entries: entries.sort((a, b) => MEMBER_KEYS.indexOf(a.member) - MEMBER_KEYS.indexOf(b.member)),
  hours: sumHours(entries),
}));
const maxDay = Math.max(1, ...days.map((d) => d.hours));

/** Total, days worked and average per day for a set of entries. */
function summarise(entries: TimeEntry[]) {
  const hours = sumHours(entries);
  const dayCount = new Set(entries.map((e) => e.date)).size;
  return [fmt(hours), dayCount, fmt(dayCount ? hours / dayCount : 0)];
}

const members = MEMBER_KEYS.map((key) => {
  const entries = timelog.filter((e) => e.member === key);
  const topics = TOPIC_KEYS.map((topic) => ({
    key: topic,
    hours: sumHours(entries.filter((e) => e.topic === topic)),
  })).filter((t) => t.hours > 0);
  return { key, name: TEAM[key].name, color: TEAM[key].color, tint: TEAM[key].tint, values: summarise(entries), topics };
});
---

<Base title="Time tracking" description="Overview of hours spent per day on the bachelor thesis.">
  <p class="eyebrow">Time tracking</p>
  <h1>Hours per day</h1>
  <p class="lead">An overview of how much time each of us spends on our bachelor thesis, per day and per topic.</p>

  <MemberStatsTable
    columns={['Total hours', 'Days worked', 'Average per day']}
    rows={members}
    total={summarise(timelog)}
  />

  {
    members.some((m) => m.topics.length > 0) && (
      <section>
        <h2>Per topic</h2>
        <div class="members">
          {members.map((m) => (
            <div class="member" style={`--c: ${m.color}; --t: ${m.tint}`}>
              <h3>{m.name}</h3>
              {m.topics.length === 0 ? (
                <p class="note">No hours logged yet.</p>
              ) : (
                <>
                  <div class="split" role="img" aria-label={`Share of hours per topic for ${m.name}`}>
                    {m.topics.map((t) => (
                      <span
                        style={`flex: ${t.hours}; background: ${TOPICS[t.key].color}`}
                        title={`${TOPICS[t.key].label}: ${fmt(t.hours)}h`}
                      />
                    ))}
                  </div>
                  <ul class="legend">
                    {m.topics.map((t) => (
                      <li>
                        <TopicChip topic={t.key} link={false} /> {fmt(t.hours)}h
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section>
    <h2>Per day</h2>
    <ul class="key" aria-label="Bar colours per team member">
      {members.map((m) => (
        <li><span style={`background: ${m.color}`} />{m.name}</li>
      ))}
    </ul>
    {days.length === 0 && <p class="note">No hours logged yet — add entries in src/data/timelog.ts.</p>}
    <ol class="days">
      {
        days.map((day) => (
          <li class="day">
            <details>
              <summary>
                <time datetime={day.date.toISOString().slice(0, 10)}>
                  {formatDate(day.date, { weekday: 'short' })}
                </time>
                <span class="bar" style={`width: ${(day.hours / maxDay) * 100}%`}>
                  {day.entries.map((e) => (
                    <span
                      style={`flex: ${e.hours}; background: ${TEAM[e.member].color}`}
                      title={`${TEAM[e.member].name}: ${fmt(e.hours)}h`}
                    />
                  ))}
                </span>
                <span class="hours">{fmt(day.hours)}h</span>
              </summary>
              <ul class="entries">
                {day.entries.map((e) => (
                  <li>
                    <span class="who" style={`--c: ${TEAM[e.member].color}; --t: ${TEAM[e.member].tint}`}>
                      {TEAM[e.member].name}
                    </span>
                    <TopicChip topic={e.topic} link={false} />
                    <span>{e.task}</span>
                    <span class="h">{fmt(e.hours)}h</span>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .members {
    display: grid;
    gap: 1.75rem;
  }
  .member h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    font-size: 1rem;
  }
  .member h3::before {
    content: '';
    width: 0.65em;
    height: 0.65em;
    border-radius: 50%;
    background: var(--c);
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .key li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .key span {
    width: 0.65em;
    height: 0.65em;
    border-radius: 50%;
  }
  .split {
    display: flex;
    gap: 3px;
    height: 0.9rem;
    border-radius: 999px;
    overflow: hidden;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }
  .days {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }
  summary {
    display: grid;
    grid-template-columns: 9rem 1fr 3.5rem;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
    cursor: pointer;
    list-style: none;
    font-size: 0.92rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  details[open] summary {
    background: var(--surface);
  }
  time {
    color: var(--muted);
  }
  .bar {
    display: flex;
    gap: 2px;
    height: 0.75rem;
    min-width: 0.75rem;
    border-radius: 999px;
    overflow: hidden;
  }
  .hours {
    text-align: right;
    font-weight: 600;
  }
  .entries {
    list-style: none;
    margin: 0.25rem 0 0.75rem;
    padding: 0 0.75rem 0 10.75rem;
    display: grid;
    gap: 0.4rem;
    font-size: 0.9rem;
  }
  .entries li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .entries .who {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--t);
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .entries .h {
    margin-left: auto;
    color: var(--muted);
  }
  @media (max-width: 40rem) {
    summary {
      grid-template-columns: 6.5rem 1fr 3rem;
    }
    .entries {
      padding-left: 0.75rem;
    }
    .entries li {
      flex-wrap: wrap;
    }
  }
</style>
