---
// "New post" form — only available while running `npm run dev` (see integrations/new-post.mjs).
// It saves the post as a Markdown file in src/content/blog/.
import Base from '../layouts/Base.astro';
import { TEAM, MEMBER_KEYS, TOPICS, TOPIC_KEYS } from '../consts';
import { url } from '../utils';

// Reuse the existing templates so the form starts with the same structure.
const rawTemplates = import.meta.glob('../content/blog/_template*.md', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const templateLabels: Record<string, string> = {
  _template: 'General post',
  '_template-feedback': 'Feedback / meeting report',
  '_template-ai': 'AI usage log',
};

const templates = Object.entries(rawTemplates)
  .map(([file, raw]) => {
    const id = file.split('/').pop()!.replace(/\.md$/, '');
    const [, frontmatter = '', body = ''] = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/) ?? [];
    const field = (name: string) =>
      (frontmatter.match(new RegExp(`^${name}:\\s*\\[(.*)\\]`, 'm'))?.[1] ?? '')
        .split(',')
        .map((s) => s.trim().replace(/^["']|["']$/g, ''))
        .filter(Boolean);
    return { id, label: templateLabels[id] ?? id, body: body.trim(), topics: field('topics'), tags: field('tags') };
  })
  .sort((a, b) => (a.id === '_template' ? -1 : b.id === '_template' ? 1 : a.label.localeCompare(b.label)));

const today = new Date().toISOString().slice(0, 10);
const first = templates[0];
---

<Base title="New post" description="Write a new post for the process blog.">
  <p class="eyebrow">Only visible while running npm run dev</p>
  <h1>New post</h1>
  <p class="lead">Fill in the form and save. The post is written to <code>src/content/blog/</code> as a Markdown file, which you can still edit afterwards.</p>

  <form id="new-post" data-templates={JSON.stringify(templates)}>
    <label class="field">
      <span>Template</span>
      <select name="template">
        {templates.map((t) => <option value={t.id}>{t.label}</option>)}
      </select>
    </label>

    <label class="field">
      <span>Title</span>
      <input name="title" required placeholder="e.g. User interviews round 1" />
    </label>

    <label class="field">
      <span>Description</span>
      <input name="description" required placeholder="One sentence that summarises the post." />
    </label>

    <label class="field narrow">
      <span>Date</span>
      <input type="date" name="date" value={today} required />
    </label>

    <fieldset>
      <legend>Authors</legend>
      <div class="options">
        {
          MEMBER_KEYS.map((key, i) => (
            <label class="option" style={`--c: ${TEAM[key].color}; --t: ${TEAM[key].tint}`}>
              <input type="checkbox" name="authors" value={key} checked={i === 0} /> {TEAM[key].name}
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset>
      <legend>Topics</legend>
      <div class="options">
        {
          TOPIC_KEYS.map((key) => (
            <label class="option" style={`--c: ${TOPICS[key].color}; --t: ${TOPICS[key].tint}`}>
              <input type="checkbox" name="topics" value={key} checked={first?.topics.includes(key)} />
              {TOPICS[key].label}
            </label>
          ))
        }
      </div>
    </fieldset>

    <label class="field">
      <span>Tags <small>(comma separated, optional)</small></span>
      <input name="tags" value={first?.tags.join(', ')} placeholder="interview, figma" />
    </label>

    <div class="field">
      <label for="body">Content <small>(Markdown)</small></label>
      <textarea id="body" name="body" rows="18">{first?.body}</textarea>
      <div class="images">
        <label class="upload">
          <input type="file" name="images" accept="image/jpeg,image/png,image/webp,image/gif,image/avif,image/svg+xml" multiple />
          + Add images
        </label>
        <small>…or drag images onto the content box, or paste a screenshot. They are inserted at the cursor.</small>
      </div>
      <ul class="thumbs" hidden></ul>
    </div>

    <label class="option draft">
      <input type="checkbox" name="draft" /> Save as draft (hidden from the site)
    </label>

    <div class="actions">
      <button type="submit">Save post</button>
      <p class="message" aria-live="polite"></p>
    </div>
  </form>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#new-post')!;
  const message = form.querySelector<HTMLElement>('.message')!;
  const button = form.querySelector<HTMLButtonElement>('button')!;
  const templates: { id: string; body: string; topics: string[]; tags: string[] }[] = JSON.parse(
    form.dataset.templates!,
  );
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');

  const field = <T extends HTMLElement>(name: string) => form.elements.namedItem(name) as unknown as T;
  const checked = (name: string) =>
    [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value);

  let pristineBody = field<HTMLTextAreaElement>('body').value;

  field<HTMLSelectElement>('template').addEventListener('change', (e) => {
    const t = templates.find((t) => t.id === (e.target as HTMLSelectElement).value);
    if (!t) return;
    const body = field<HTMLTextAreaElement>('body');
    if (body.value !== pristineBody && !confirm('Replace the content you wrote with this template?')) return;
    body.value = pristineBody = t.body;
    field<HTMLInputElement>('tags').value = t.tags.join(', ');
    for (const input of form.querySelectorAll<HTMLInputElement>('input[name="topics"]')) {
      input.checked = t.topics.includes(input.value);
    }
  });

  // --- Images -------------------------------------------------------------
  const body = field<HTMLTextAreaElement>('body');
  const thumbs = form.querySelector<HTMLUListElement>('.thumbs')!;
  const fileInput = form.querySelector<HTMLInputElement>('input[name="images"]')!;

  /** Insert text at the cursor and select the part between `selectFrom` and `selectTo`. */
  function insertAtCursor(text: string, selectFrom = text.length, selectTo = text.length) {
    const start = body.selectionStart;
    const before = body.value.slice(0, start);
    const after = body.value.slice(body.selectionEnd);
    // Images go on their own line.
    const pre = before && !before.endsWith('\n\n') ? (before.endsWith('\n') ? '\n' : '\n\n') : '';
    const post = after.startsWith('\n') ? '\n' : '\n\n';
    body.value = before + pre + text + post + after;
    body.focus();
    const offset = start + pre.length;
    body.setSelectionRange(offset + selectFrom, offset + selectTo);
  }

  async function uploadImages(files: Iterable<File>) {
    for (const file of files) {
      if (!file.type.startsWith('image/')) continue;
      const item = document.createElement('li');
      const img = document.createElement('img');
      img.src = URL.createObjectURL(file);
      img.alt = '';
      const label = document.createElement('span');
      label.textContent = 'Uploading…';
      item.append(img, label);
      thumbs.append(item);
      thumbs.hidden = false;

      try {
        const res = await fetch('/__upload-image', {
          method: 'POST',
          headers: { 'Content-Type': file.type, 'X-Filename': encodeURIComponent(file.name || 'screenshot') },
          body: file,
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.errors?.join(' ') ?? 'Upload failed.');
        label.textContent = data.path;
        // Select the alt text so you can type a description straight away.
        const alt = 'Describe the image';
        insertAtCursor(`![${alt}](${data.path})`, 2, 2 + alt.length);
      } catch (error) {
        item.classList.add('failed');
        label.textContent = `${file.name}: ${(error as Error).message}`;
      }
    }
  }

  fileInput.addEventListener('change', async () => {
    await uploadImages([...(fileInput.files ?? [])]);
    fileInput.value = '';
  });
  body.addEventListener('dragover', (e) => {
    if (e.dataTransfer?.types.includes('Files')) {
      e.preventDefault();
      body.classList.add('dragging');
    }
  });
  body.addEventListener('dragleave', () => body.classList.remove('dragging'));
  body.addEventListener('drop', (e) => {
    if (!e.dataTransfer?.files.length) return;
    e.preventDefault();
    body.classList.remove('dragging');
    uploadImages([...e.dataTransfer.files]);
  });
  body.addEventListener('paste', (e) => {
    const files = [...(e.clipboardData?.files ?? [])].filter((f) => f.type.startsWith('image/'));
    if (!files.length) return;
    e.preventDefault();
    uploadImages(files);
  });

  // --- Save ---------------------------------------------------------------
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    message.className = 'message';
    message.textContent = '';

    const post = {
      title: field<HTMLInputElement>('title').value.trim(),
      description: field<HTMLInputElement>('description').value.trim(),
      date: field<HTMLInputElement>('date').value,
      authors: checked('authors'),
      topics: checked('topics'),
      tags: field<HTMLInputElement>('tags')
        .value.split(',')
        .map((t) => t.trim())
        .filter(Boolean),
      body: field<HTMLTextAreaElement>('body').value,
      draft: field<HTMLInputElement>('draft').checked,
    };

    const problems = [];
    if (post.authors.length === 0) problems.push('Pick at least one author.');
    if (post.topics.length === 0) problems.push('Pick at least one topic.');
    if (problems.length) {
      message.classList.add('error');
      message.textContent = problems.join(' ');
      return;
    }

    button.disabled = true;
    try {
      const res = await fetch('/__new-post', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(post),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.errors?.join(' ') ?? 'Could not save the post.');

      message.classList.add('success');
      message.innerHTML = post.draft
        ? `Saved as draft in <code>${data.file}</code>. Set <code>draft: false</code> to publish it.`
        : `Saved to <code>${data.file}</code>. <a href="${base}/blog/${data.slug}/">View the post →</a>`;
      form.reset();
      thumbs.replaceChildren();
      thumbs.hidden = true;
      field<HTMLInputElement>('date').value = new Date().toISOString().slice(0, 10);
      field<HTMLSelectElement>('template').dispatchEvent(new Event('change'));
    } catch (error) {
      message.classList.add('error');
      message.textContent = (error as Error).message;
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  form {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field.narrow {
    max-width: 12rem;
  }
  .field > span,
  .field > label,
  legend {
    font-size: 0.85rem;
    font-weight: 600;
  }
  small {
    font-weight: 400;
    color: var(--muted);
  }
  input:not([type='checkbox']),
  select,
  textarea {
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.55rem 0.75rem;
  }
  textarea {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.5;
    resize: vertical;
  }
  textarea.dragging {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
    background: var(--accent-soft);
  }
  .images {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .upload {
    position: relative;
    display: inline-flex;
    padding: 0.35rem 0.9rem;
    border: 1px dashed var(--accent);
    border-radius: 999px;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .upload:hover,
  .upload:focus-within {
    background: var(--accent-soft);
  }
  .upload input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
  }
  .thumbs li {
    display: grid;
    gap: 0.3rem;
    width: 8rem;
    font-size: 0.75rem;
    color: var(--muted);
    word-break: break-all;
  }
  .thumbs img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--line);
  }
  .thumbs .failed {
    color: #b4463c;
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  legend {
    margin-bottom: 0.5rem;
  }
  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .option {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9rem;
    cursor: pointer;
  }
  .option:has(input:checked) {
    background: var(--t, var(--accent-soft));
    border-color: var(--c, var(--accent));
  }
  .option input {
    accent-color: var(--c, var(--accent));
  }
  .draft {
    justify-self: start;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  button {
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .message {
    margin: 0;
    font-size: 0.9rem;
  }
  .message.error {
    color: #b4463c;
  }
  .message.success {
    color: var(--ink);
  }
</style>
