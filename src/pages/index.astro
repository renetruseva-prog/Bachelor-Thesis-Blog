---
import Base from '../layouts/Base.astro';
import FilterablePosts from '../components/FilterablePosts.astro';
import { SITE, TEAM, MEMBER_KEYS } from '../consts';
import { getPosts } from '../utils';
import { timelog } from '../data/timelog';

const posts = await getPosts();

const sumHours = (entries: typeof timelog) => entries.reduce((sum, e) => sum + e.hours, 0);
const memberStats = MEMBER_KEYS.map((key) => {
  const entries = timelog.filter((e) => e.member === key);
  return {
    name: TEAM[key].name,
    posts: posts.filter((p) => p.data.authors.includes(key)).length,
    hours: sumHours(entries),
    days: new Set(entries.map((e) => e.date)).size,
  };
});
const totals = {
  posts: posts.length,
  hours: sumHours(timelog),
  days: new Set(timelog.map((e) => e.date)).size,
};
const fmt = (n: number) => n.toLocaleString('en-GB', { maximumFractionDigits: 1 });
---

<Base>
  <section class="hero">
    <h1>{SITE.title}</h1>
    <p class="lead">
      A running log of our team's research, design and development process — including feedback, planning, hours and
      an honest account of how we use AI and other technologies.
    </p>
    <div class="stats-wrap">
      <table class="stats">
        <thead>
          <tr>
            <th scope="col">Team member</th>
            <th scope="col">Posts</th>
            <th scope="col">Hours logged</th>
            <th scope="col">Days worked</th>
          </tr>
        </thead>
        <tbody>
          {
            memberStats.map((m) => (
              <tr>
                <th scope="row">{m.name}</th>
                <td>{m.posts}</td>
                <td>{fmt(m.hours)}</td>
                <td>{m.days}</td>
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">Team total</th>
            <td>{totals.posts}</td>
            <td>{fmt(totals.hours)}</td>
            <td>{totals.days}</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </section>

  <FilterablePosts posts={posts} />
</Base>

<style>
  .hero {
    margin-bottom: 3rem;
  }
  .stats-wrap {
    margin: 2rem 0 0;
    overflow-x: auto;
  }
  .stats {
    width: 100%;
    max-width: 40rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .stats th,
  .stats td {
    padding: 0.6rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }
  .stats td {
    text-align: right;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .stats thead th {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }
  .stats thead th:not(:first-child) {
    text-align: right;
  }
  .stats tbody th {
    font-weight: 500;
  }
  .stats tfoot th,
  .stats tfoot td {
    border-bottom: none;
    border-top: 2px solid var(--line);
  }
  .stats tfoot th {
    color: var(--muted);
    font-weight: 500;
  }
</style>
