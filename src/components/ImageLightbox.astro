---
// Click (or press Enter on) an image inside `selector` to view it large in an overlay.
// Close with Esc, the × button or a click next to the image; ← / → go through the post's images.
interface Props {
  selector?: string;
}

const { selector = '.content img' } = Astro.props;
---

<dialog class="lightbox" data-selector={selector} aria-label="Image viewer">
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button class="close" type="button" aria-label="Close">×</button>
  <button class="nav prev" type="button" aria-label="Previous image">‹</button>
  <button class="nav next" type="button" aria-label="Next image">›</button>
  <p class="counter" aria-live="polite"></p>
</dialog>

<script>
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog.lightbox')) {
    const images = [...document.querySelectorAll<HTMLImageElement>(dialog.dataset.selector!)];
    if (images.length === 0) continue;

    const big = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    const counter = dialog.querySelector<HTMLElement>('.counter')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.next')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const multiple = images.length > 1;
    prev.hidden = next.hidden = counter.hidden = !multiple;

    function show(i: number) {
      index = (i + images.length) % images.length;
      const img = images[index];
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      caption.textContent = img.alt;
      caption.hidden = !img.alt;
      counter.textContent = `${index + 1} / ${images.length}`;
    }

    function open(i: number) {
      opener = images[i];
      show(i);
      dialog.showModal();
      document.documentElement.classList.add('lightbox-open');
    }

    images.forEach((img, i) => {
      img.classList.add('zoomable');
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', `Enlarge image${img.alt ? `: ${img.alt}` : ''}`);
      img.addEventListener('click', () => open(i));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(i);
        }
      });
    });

    dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));

    // A click on the dark background (not on the image or a button) closes the overlay.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === dialog.querySelector('figure')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (!multiple) return;
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lightbox-open');
      opener?.focus();
    });
  }
</script>

<style>
  :global(.zoomable) {
    cursor: zoom-in;
    transition: opacity 0.15s ease;
  }
  :global(.zoomable:hover) {
    opacity: 0.9;
  }
  :global(.zoomable:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  :global(html.lightbox-open) {
    overflow: hidden;
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
  }
  .lightbox::backdrop {
    background: rgb(20 24 21 / 0.88);
    backdrop-filter: blur(4px);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: fade 0.15s ease;
  }
  figure {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 3.5rem 4.5rem 3rem;
    box-sizing: border-box;
    align-content: center;
  }
  figure img {
    max-width: 100%;
    max-height: calc(100vh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    background: #fff;
  }
  figcaption {
    max-width: 46rem;
    font-size: 0.9rem;
    text-align: center;
    color: rgb(255 255 255 / 0.85);
  }
  button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }
  button:hover,
  button:focus-visible {
    background: rgb(255 255 255 / 0.25);
  }
  button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .close {
    top: 1rem;
    right: 1rem;
  }
  .nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 2.25rem;
  }
  .prev {
    left: 1rem;
  }
  .next {
    right: 1rem;
  }
  .counter {
    position: absolute;
    top: 1.6rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.8rem;
    color: rgb(255 255 255 / 0.7);
  }
  [hidden] {
    display: none;
  }
  @media (max-width: 40rem) {
    figure {
      padding: 3.5rem 0.75rem 4.5rem;
    }
    .nav {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>
